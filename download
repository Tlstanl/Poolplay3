  if (!pollState || !pollState.next_interval_reason) { el.textContent = "—"; return; }
  const remaining = pollState.next_poll_at ? pollState.next_poll_at - Date.now()/1000 : null;
  const label = POLL_REASON_LABEL[pollState.next_interval_reason] || pollState.next_interval_reason;
  el.innerHTML = `<span class="poll-reason r-${pollState.next_interval_reason}">${label}</span><span class="muted"> · next poll in ${fmtDurationShort(remaining)}</span>`;

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Pool Play Seed Projections</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  :root {
    --bg: #0d1720;
    --card: #182230;
    --line: #2a3648;
    --muted: #8aa0b6;
    --fg: #e5ecf4;
    --accent: #4ea8ff;
    --good: #4ee07b;
    --warn: #ffb74e;
    --bad: #ff6b6b;
    --locked: #4ee07b;
    --band: #3a4f6a;
    --bandbar: #4ea8ff;
    --sb-amber: #ffc14a;
    --sb-grass: #2e7d3d;
    --sb-clay:  #b25a2a;
  }
  body::before {
    content: "";
    position: fixed; left: 0; right: 0; top: 0; height: 110px;
    background:
      linear-gradient(180deg, rgba(46, 125, 61, 0.18) 0%, rgba(46, 125, 61, 0) 100%),
      linear-gradient(90deg, rgba(255, 193, 74, 0.08) 0%, rgba(255, 193, 74, 0) 70%);
    pointer-events: none;
    z-index: 0;
  }
  header, main { position: relative; z-index: 1; }
  *, *::before, *::after { box-sizing: border-box; }
  html, body { background: var(--bg); color: var(--fg); margin: 0; font: 14px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif; overflow-x: hidden; }
  header {
    display: flex; align-items: center; gap: 1rem;
    padding: 14px 22px;
    border-bottom: 1px solid var(--line);
    box-shadow: inset 0 -2px 0 var(--sb-amber);
  }
  header .headings { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  header h1 {
    font-size: 18px; margin: 0; font-weight: 700;
    display: flex; align-items: center; gap: 8px;
    letter-spacing: 0.2px;
  }
  header h1::before {
    content: "⚾";
    font-size: 16px;
    filter: drop-shadow(0 0 3px rgba(255, 193, 74, 0.6));
  }
  header .sub { color: var(--muted); font-size: 13px; }
  header .right { margin-left: auto; color: var(--muted); font-size: 12px; text-align: right; }
  header .right a { color: var(--accent); text-decoration: none; }
  .poll-reason { display: inline-block; padding: 1px 8px; border-radius: 100px; font-size: 11px; font-weight: 600; letter-spacing: 0.3px; text-transform: uppercase; }
  .poll-reason.r-finishing { background: rgba(255, 107, 107, 0.15); color: var(--bad); }
  .poll-reason.r-in_progress { background: rgba(255, 183, 78, 0.15); color: var(--warn); }
  .poll-reason.r-waiting { background: #253146; color: var(--muted); }
  .poll-reason.r-idle { background: #253146; color: var(--muted); }
  main { padding: 18px 22px 40px; display: flex; flex-direction: column; gap: 26px; }
  .pool {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    border-left: 3px solid var(--sb-amber);
  }
  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .pool h2 {
    margin: 0; padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    font-size: 15px; font-weight: 700; letter-spacing: 0.3px;
    display: flex; align-items: center; gap: 12px;
    background: linear-gradient(90deg, rgba(255, 193, 74, 0.06) 0%, rgba(255, 193, 74, 0) 40%);
  }
  .pool h2::first-letter { color: var(--sb-amber); }
  .pool h2 .chip {
    background: #253146; color: var(--muted);
    padding: 2px 10px; border-radius: 100px;
    font-size: 12px; font-weight: 500; letter-spacing: 0.3px;
  }
  .pool h2 .chip.final {
    background: rgba(46, 125, 61, 0.25); color: var(--good);
    border: 1px solid rgba(78, 224, 123, 0.25);
  }
  .pool h2 .col-toggle {
    display: none; margin-left: auto; padding: 3px 10px; border-radius: 100px;
    font-size: 11px; font-weight: 600; letter-spacing: 0.3px;
    background: rgba(255, 193, 74, 0.1); color: var(--sb-amber);
    border: 1px solid rgba(255, 193, 74, 0.3); cursor: pointer;
  }
  .pool h2 .col-toggle:hover { background: rgba(255, 193, 74, 0.18); border-color: rgba(255, 193, 74, 0.5); }
  @media (max-width: 680px) { .pool h2 .col-toggle { display: inline-flex; align-items: center; } }
  table.standings { width: 100%; border-collapse: collapse; }
  .standings th, .standings td { padding: 8px 12px; text-align: right; font-variant-numeric: tabular-nums; }
  .standings th:first-child, .standings td:first-child { text-align: left; }
  .standings th.team, .standings td.team { text-align: left; }
  .standings thead th { color: var(--muted); font-weight: 500; border-bottom: 1px solid var(--line); font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; }
  .standings tbody tr:not(:last-child) td { border-bottom: 1px solid var(--line); }
  .standings tbody tr:nth-child(even) { background: rgba(255, 255, 255, 0.015); }
  .standings tbody tr.locked { background: rgba(78, 224, 123, 0.05); }
  .standings tbody tr.playing-now { box-shadow: inset 3px 0 0 0 var(--sb-amber); }
  .playing-dot { display: inline-block; margin-right: 4px; font-size: 12px; line-height: 1; filter: drop-shadow(0 0 3px rgba(255, 193, 74, 0.6)); }
  td.team { vertical-align: middle; }
  .team-logo { display: inline-block; width: 22px; height: 22px; border-radius: 5px; object-fit: contain; background: #131a27; border: 1px solid var(--line); padding: 1px; vertical-align: -6px; margin-right: 6px; }
  .team-name { vertical-align: middle; }
  .team-links { display: inline-flex; align-items: center; gap: 4px; vertical-align: middle; }
  td.c-links, th.c-links { width: 1%; white-space: nowrap; text-align: center; }
  .team-link { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 5px; text-decoration: none; border: 1px solid transparent; box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 1px 2px rgba(0, 0, 0, 0.35); transition: background 0.1s, border-color 0.1s, transform 0.08s, box-shadow 0.1s; }
  .team-link:hover { transform: translateY(-1px); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 2px 5px rgba(0, 0, 0, 0.5); }
  .team-link:active { transform: translateY(0); box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.35); }
  .team-link img { display: block; width: 14px; height: 14px; object-fit: contain; background: rgba(255, 255, 255, 0.9); border-radius: 2px; padding: 1px; box-sizing: content-box; }
  .team-link.usssa { background: rgba(80, 110, 200, 0.18); border-color: rgba(80, 110, 200, 0.45); }
  .team-link.usssa:hover { background: rgba(80, 110, 200, 0.3); border-color: rgba(80, 110, 200, 0.7); }
  .team-link.gc { background: rgba(38, 208, 124, 0.16); border-color: rgba(38, 208, 124, 0.45); }
  .team-link.gc:hover { background: rgba(38, 208, 124, 0.28); border-color: rgba(38, 208, 124, 0.7); }
  .seed-range { position: relative; width: 140px; max-width: 100%; box-sizing: border-box; height: 20px; background: #0d1420; border-radius: 4px; border: 1px solid var(--line); overflow: hidden; }
  .seed-range .bar { position: absolute; top: 0; bottom: 0; background: var(--bandbar); opacity: 0.55; border-radius: 2px; }
  .seed-range .marker { position: absolute; top: -1px; bottom: -1px; width: 2px; background: #fff; box-shadow: 0 0 3px rgba(0,0,0,0.8); }
  .seed-range .label { position: relative; z-index: 2; display: block; font-size: 11px; font-weight: 700; color: #fff; text-align: center; line-height: 20px; text-shadow: 0 0 3px rgba(0, 0, 0, 0.95), 0 1px 2px rgba(0, 0, 0, 0.9); }
  .seed-range .label.locked { display: flex; align-items: center; justify-content: center; gap: 4px; }
  .seed-range .seed-lock { width: 11px; height: 11px; color: var(--locked); flex: 0 0 auto; filter: drop-shadow(0 0 2px rgba(0, 0, 0, 0.95)); }
  td.c-range, th.c-range-header { width: 160px; text-align: center; }
  td.c-bracket { white-space: nowrap; text-align: center; width: 140px; }
  .bp-chip { display: inline-flex; align-items: center; justify-content: center; min-width: 120px; min-height: 20px; padding: 2px 10px; background: rgba(255, 193, 74, 0.12); color: var(--sb-amber); border: 1px solid rgba(255, 193, 74, 0.25); border-radius: 8px; font-size: 11px; font-weight: 600; font-variant-numeric: tabular-nums; letter-spacing: 0.3px; box-sizing: border-box; }
  .bp-chip.multi { flex-direction: column; align-items: stretch; padding: 3px 10px; gap: 1px; }
  .bp-chip.multi .bp-line { display: block; text-align: center; line-height: 1.2; white-space: nowrap; }
  .bp-chip.multi .bp-line + .bp-line { border-top: 1px dashed rgba(255, 193, 74, 0.25); padding-top: 2px; margin-top: 1px; }
  .bp-chip-wrap { position: relative; display: inline-block; }
  .bp-chip { cursor: pointer; user-select: none; }
  .bp-chip:hover { background: rgba(255, 193, 74, 0.18); border-color: rgba(255, 193, 74, 0.4); }
  .bp-chip[aria-expanded="true"] { background: rgba(255, 193, 74, 0.22); border-color: rgba(255, 193, 74, 0.55); }
  .bp-popover { display: none; position: fixed; z-index: 40; min-width: 220px; max-width: min(320px, 90vw); padding: 8px 10px 10px; background: #141b29; border: 1px solid rgba(255, 193, 74, 0.35); border-radius: 8px; box-shadow: 0 6px 18px rgba(0, 0, 0, 0.55); color: #cbd5e3; text-align: left; font-size: 12px; font-weight: 500; letter-spacing: 0.2px; white-space: normal; }
  .bp-chip-wrap.open .bp-popover { display: block; }
  .bp-pop-group + .bp-pop-group { margin-top: 8px; padding-top: 8px; border-top: 1px dashed rgba(255, 193, 74, 0.18); }
  .bp-pop-bracket { font-size: 10px; font-weight: 700; color: var(--sb-amber); letter-spacing: 0.8px; text-transform: uppercase; margin-bottom: 3px; }
  .bp-popover ul { list-style: none; margin: 0; padding: 0; }
  .bp-popover li { padding: 2px 0; font-variant-numeric: tabular-nums; line-height: 1.35; display: flex; flex-wrap: wrap; gap: 6px; align-items: baseline; }
  .bp-pop-time { color: #e5ecf4; font-weight: 600; min-width: 50px; }
  .bp-pop-seeds { color: var(--muted); font-size: 11px; }
  .bp-pop-field { color: #9fb0c5; font-size: 11px; }
  .pill { display: inline-flex; align-items: center; justify-content: center; min-width: 28px; height: 22px; padding: 0 8px; border-radius: 100px; font-size: 12px; font-weight: 600; font-variant-numeric: tabular-nums; background: #253146; color: var(--muted); line-height: 1; }
  .pill.locked { background: rgba(78, 224, 123, 0.15); color: var(--locked); }
  .pill.best { background: rgba(78, 168, 255, 0.15); color: var(--accent); }
  .pill.worst { background: rgba(255, 107, 107, 0.15); color: var(--bad); }
  .bye { color: var(--muted); }
  .muted { color: var(--muted); }
  .diff-pos { color: var(--good); }
  .diff-neg { color: var(--bad); }
  .error { background: #3a1818; color: var(--bad); padding: 10px 16px; border-radius: 8px; }
  .games { padding: 12px 16px 14px; border-top: 1px solid var(--line); }
  .games details { width: 100%; }
  .games summary { cursor: pointer; color: var(--muted); font-size: 12px; padding: 2px 0 10px; list-style: none; }
  .games summary::-webkit-details-marker { display: none; }
  .games summary::before { content: "▸"; display: inline-block; margin-right: 6px; transition: transform .12s; }
  .games details[open] > summary::before { transform: rotate(90deg); }
  .game-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 10px; }
  .sb { background: linear-gradient(180deg, #0b1018 0%, #08101b 100%); border: 1px solid #1b2738; border-radius: 8px; padding: 8px 10px 6px; font-family: "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace; color: #cbd5e3; position: relative; overflow: hidden; }
  .sb-head { display: flex; justify-content: space-between; align-items: center; font-size: 10px; letter-spacing: 1px; text-transform: uppercase; color: #6a7e97; margin-bottom: 6px; }
  .sb-head .sb-time { color: #6a7e97; }
  .sb-head .sb-stream-chip { display: inline-flex; align-items: center; gap: 4px; margin: 0 auto 0 8px; padding: 1px 6px; border-radius: 3px; font-size: 10px; font-weight: 700; letter-spacing: 1px; text-decoration: none; background: rgba(38, 208, 124, 0.16); color: #3ad68c; border: 1px solid rgba(38, 208, 124, 0.45); }
  .sb-head .sb-stream-chip:hover { background: rgba(38, 208, 124, 0.28); border-color: rgba(38, 208, 124, 0.7); }
  .sb-badge { display: inline-flex; align-items: center; gap: 4px; padding: 1px 6px; border-radius: 3px; font-weight: 700; font-size: 10px; letter-spacing: 1.5px; }
  .sb-badge.final { background: #162034; color: #7aa9ff; border: 1px solid #1f335a; }
  .sb-badge.sched { background: #141b29; color: #6a7e97; border: 1px solid #212d42; }
  .sb-badge.live { background: #3a0e0e; color: #ff5a5a; border: 1px solid #6a1a1a; animation: sb-pulse 2.6s infinite ease-in-out; }
  .sb-badge.live .dot { width: 6px; height: 6px; border-radius: 50%; background: #ff3a3a; box-shadow: 0 0 6px #ff3a3a; }
  .sb-badge.tie { background: #1f2634; color: #c7b465; border: 1px solid #353520; }
  .sb-badge.final-gc { background: rgba(255, 193, 74, 0.18); color: var(--sb-amber); border: 1px solid rgba(255, 193, 74, 0.35); }
  .sb.final-gc { border: 1px solid rgba(255, 193, 74, 0.45); box-shadow: 0 0 0 1px rgba(255, 193, 74, 0.1), 0 0 18px rgba(255, 193, 74, 0.08); background: linear-gradient(180deg, #14110a 0%, #0a0807 100%); }
  .sb.final-gc .sb-score { color: var(--sb-amber); }
  .sb-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; padding: 4px 0; border-top: 1px dashed #1a2436; }
  .sb-row:first-of-type { border-top: none; }
  .sb-team { display: flex; align-items: center; gap: 6px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif; font-weight: 600; color: #9fb0c5; font-size: 13px; min-width: 0; }
  .sb-team .name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sb-team .region { font-size: 10px; color: #5b7091; padding: 1px 4px; border: 1px solid #22314a; border-radius: 3px; font-family: monospace; font-weight: 600; }
  .sb-gc-btn { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 22px; height: 22px; margin-left: 6px; border-radius: 4px; text-decoration: none; background: rgba(38, 208, 124, 0.16); border: 1px solid rgba(38, 208, 124, 0.45); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 1px 2px rgba(0, 0, 0, 0.35); transition: background 0.1s, border-color 0.1s, transform 0.08s, box-shadow 0.1s; }
  .sb-gc-btn:hover { background: rgba(38, 208, 124, 0.28); border-color: rgba(38, 208, 124, 0.7); transform: translateY(-1px); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 2px 5px rgba(0, 0, 0, 0.5); }
  .sb-gc-btn:active { transform: translateY(0); box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.35); }
  .sb-gc-btn img { display: block; width: 12px; height: 12px; object-fit: contain; background: rgba(255, 255, 255, 0.9); border-radius: 2px; padding: 1px; box-sizing: content-box; }
  .sb-score { font-size: 22px; font-weight: 700; color: #4a5b75; font-variant-numeric: tabular-nums; padding-left: 14px; letter-spacing: 1px; }
  .sb-row.winner .sb-team { color: #fff; }
  .sb-row.winner .sb-score { color: #ffc14a; text-shadow: 0 0 6px rgba(255, 193, 74, 0.35); }
  .sb-row.loser .sb-team { color: #6a7e97; }
  .sb-row.loser .sb-score { color: #384963; }
  .sb-row.tie .sb-team { color: #e5ecf4; }
  .sb-row.tie .sb-score { color: #c7b465; }
  .sb-row.sched .sb-score { color: #2b3a52; }
  .sb-foot { margin-top: 4px; padding-top: 4px; border-top: 1px solid #141c2b; font-size: 10px; color: #5b7091; letter-spacing: 0.3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .field-swatch { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 5px; vertical-align: 0.5px; border: 1px solid rgba(255, 255, 255, 0.15); }
  .sb.live { grid-column: span 2; border: 1px solid #6a1a1a; box-shadow: 0 0 0 1px rgba(255, 58, 58, 0.15), 0 0 22px rgba(255, 58, 58, 0.12); background: linear-gradient(180deg, #140608 0%, #0a0508 100%); }
  .sb.live { padding: 6px 10px 5px; }
  .sb.live .sb-head { margin-bottom: 3px; }
  .sb.live .sb-score { font-size: 17px; font-weight: 800; letter-spacing: 0.5px; padding-left: 10px; color: #f2eadc; text-shadow: 0 0 6px rgba(255, 210, 140, 0.25); }
  .sb.live .sb-team { font-size: 14px; color: #e5ecf4; }
  .sb.live .sb-row { padding: 2px 0; }
  .sb.live .sb-inning { font-size: 11px; color: #ff9a6a; letter-spacing: 1px; font-weight: 600; margin-left: 6px; }
  .sb.live .sb-counts { display: flex; flex-wrap: wrap; gap: 6px 10px; font-size: 10px; color: #c4c4c4; margin-top: 4px; padding-top: 4px; border-top: 1px solid #2a1515; justify-content: space-between; }
  .sb.live .sb-counts .k { color: #6a7e97; margin-right: 5px; letter-spacing: 1px; font-size: 9px; font-weight: 700; }
  @keyframes sb-pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(255, 58, 58, 0.30); } 50% { box-shadow: 0 0 0 3px rgba(255, 58, 58, 0.0); } }
  .sb-linescore { margin: 6px 0 2px; overflow-x: auto; font-family: "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace; }
  .sb-linescore table { border-collapse: collapse; width: auto; margin: 0 auto; font-size: 11px; table-layout: fixed; }
  .sb-linescore th, .sb-linescore td { border: 1px solid #1b2738; width: 22px; min-width: 22px; height: 20px; text-align: center; padding: 0; color: #9fb0c5; font-weight: 500; background: #0b1018; }
  .sb-linescore thead th { color: #6a7e97; font-weight: 600; background: #0a0f17; }
  .sb-linescore .ls-abbrev { width: 48px; min-width: 48px; text-align: left; padding: 0 6px; color: #cbd5e3; font-weight: 700; letter-spacing: 0.5px; }
  .sb-linescore .ls-rhe { color: #cbd5e3; font-weight: 700; }
  .sb-linescore thead .ls-rhe { color: #9fb0c5; }
  .sb-linescore .ls-rhe-first { border-left: 2px solid #253146; }
  @media (prefers-reduced-motion: reduce) { .sb-badge.live, .live-strip-title .live-dot { animation: none; } }
  .live-strip { background: linear-gradient(180deg, rgba(255, 58, 58, 0.12) 0%, rgba(255, 58, 58, 0) 100%); border: 1px solid rgba(255, 58, 58, 0.35); border-left: 3px solid #ff3a3a; border-radius: 10px; padding: 10px 14px 12px; box-shadow: 0 0 24px rgba(255, 58, 58, 0.12); }
  .live-strip-title { display: flex; align-items: center; gap: 10px; margin: 0 0 10px; font-size: 14px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: #ff8c8c; }
  .live-strip-title .live-dot { width: 9px; height: 9px; border-radius: 50%; background: #ff3a3a; box-shadow: 0 0 8px #ff3a3a; animation: sb-pulse 2.6s infinite ease-in-out; }
  .live-strip-title .chip { background: rgba(255, 58, 58, 0.15); color: #ff8c8c; border: 1px solid rgba(255, 58, 58, 0.3); padding: 2px 10px; border-radius: 100px; font-size: 11px; font-weight: 600; letter-spacing: 0.5px; }
  .live-strip .sb.live { box-shadow: none; }
  .live-strip .sb-head .chip { background: #253146; color: var(--muted); border: 1px solid var(--line); padding: 1px 7px; border-radius: 100px; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
  @media (max-width: 680px) {
    header { flex-wrap: wrap; padding: 10px 14px; gap: 6px 12px; align-items: flex-start; }
    header .headings { flex: 1 1 auto; min-width: 0; }
    header h1 { font-size: 16px; line-height: 1.15; }
    header .sub { display: block; font-size: 12px; }
    header .right { margin-left: auto; font-size: 11px; text-align: right; line-height: 1.3; }
    main { padding: 12px 10px 40px; gap: 16px; }
    .pool h2 { padding: 10px 12px; font-size: 14px; flex-wrap: wrap; gap: 6px; }
    .pool h2 .chip { font-size: 11px; padding: 1px 8px; }
    .standings th, .standings td { padding: 6px 6px; font-size: 12px; }
    .standings th { font-size: 10px; }
    .standings th.team, .standings td.team { max-width: 140px; width: 140px; }
    .standings td.team { display: flex; align-items: center; gap: 0; min-width: 0; padding-left: 6px; }
    .standings td.team > .team-star, .standings td.team > .team-logo { flex: 0 0 auto; }
    .standings td.team .team-name { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .standings td.team .team-logo { width: 22px; height: 22px; }
    .standings td.team .team-star { width: 20px; height: 20px; font-size: 14px; margin-right: 2px; }
    .standings td.c-range, .standings th.c-range-header { width: 80px; }
    .seed-range { width: 72px; }
    .standings td.c-bracket { width: auto; }
    .standings .bp-chip { min-width: 0; padding: 0 7px; }
    .pool:not(.show-all) .standings .extra-col { display: none; }
    .game-grid { grid-template-columns: 1fr; gap: 8px; }
    .sb.live { grid-column: auto; }
    td.c-bracket { width: auto; text-align: left; }
    .bp-chip { min-width: 0; padding: 0 8px; height: auto; }
    .sb.live .sb-score { font-size: 17px; }
    .sb.live .sb-team { font-size: 14px; }
    #poll-state { font-size: 11px; }
  }

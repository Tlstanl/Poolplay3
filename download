const FIELD_COLORS = [["red","#e57373"],["orange","#ffb74d"],["yellow","#fdd835"],["green","#81c784"],["blue","#64b5f6"],["navy","#3f51b5"],["purple","#ba68c8"],["pink","#f06292"],["maroon","#ad1457"],["teal","#26a69a"],["gold","#ffc107"],["silver","#b0bec5"],["bronze","#cd7f32"],["black","#2e2e2e"],["white","#f5f5f5"],["brown","#8d6e63"]];

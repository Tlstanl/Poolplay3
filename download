  const tid=Number(star.dataset.teamId); if(!tid)return;
  if(watchedTeams.has(tid))watchedTeams.delete(tid); else watchedTeams.add(tid);
  saveWatched();
  if(lastRenderedData)render(lastRenderedData);
});
function positionBpPopover(wrap) {
  const chip=wrap.querySelector(".bp-chip"), pop=wrap.querySelector(".bp-popover");
  if(!chip||!pop)return;
  const prevDisplay=pop.style.display;
  pop.style.visibility="hidden"; pop.style.display="block";
  const pr=pop.getBoundingClientRect();
  pop.style.display=prevDisplay; pop.style.visibility="";
  const cr=chip.getBoundingClientRect(), margin=6, vw=window.innerWidth, vh=window.innerHeight;
  let left=cr.left+cr.width/2-pr.width/2;
  left=Math.max(8,Math.min(left,vw-pr.width-8));
  let top;
  if(cr.bottom+margin+pr.height<=vh-8)top=cr.bottom+margin;
  else top=Math.max(8,cr.top-margin-pr.height);
  pop.style.left=`${left}px`; pop.style.top=`${top}px`;
}
document.addEventListener("click",(ev)=>{
  const chip=ev.target.closest(".bp-chip");
  if(chip){
    const wrap=chip.closest(".bp-chip-wrap"); if(!wrap)return;
    document.querySelectorAll(".bp-chip-wrap.open").forEach(w=>{if(w!==wrap){w.classList.remove("open");w.querySelector(".bp-chip")?.setAttribute("aria-expanded","false");}});
    const nowOpen=wrap.classList.toggle("open");
    chip.setAttribute("aria-expanded",nowOpen?"true":"false");
    if(nowOpen)positionBpPopover(wrap);
    ev.stopPropagation(); return;
  }
  if(!ev.target.closest(".bp-popover")){document.querySelectorAll(".bp-chip-wrap.open").forEach(w=>{w.classList.remove("open");w.querySelector(".bp-chip")?.setAttribute("aria-expanded","false");});}
});
window.addEventListener("scroll",()=>{document.querySelectorAll(".bp-chip-wrap.open").forEach(positionBpPopover);},true);
window.addEventListener("resize",()=>{document.querySelectorAll(".bp-chip-wrap.open").forEach(positionBpPopover);});
document.addEventListener("keydown",(ev)=>{
  if(ev.key==="Escape"){document.querySelectorAll(".bp-chip-wrap.open").forEach(w=>{w.classList.remove("open");w.querySelector(".bp-chip")?.setAttribute("aria-expanded","false");});}
  else if((ev.key==="Enter"||ev.key===" ")&&ev.target.matches(".bp-chip")){ev.preventDefault();ev.target.click();}
});
const ACTIVITY_MAX=200;
const activityLog=[];
let prevGameState=null;
function gameKey(g){return `${g.pool_letter}:${g.game_number??''}:${g.team_a_id}-${g.team_b_id}`;}
function snapshotGames(data){
  const m=new Map();
  for(const p of data.pools||[]){for(const g of p.games||[]){m.set(gameKey(g),{played:!!g.played,winner:g.winner_id??null,a_score:g.winner_score,b_score:g.loser_score,is_tie:!!g.is_tie,team_a:g.team_a_name,team_b:g.team_b_name,live_a:g.live?g.live.team_a_score:null,live_b:g.live?g.live.team_b_score:null,inning:g.live?(g.live.inning_label||null):null,had_live:!!g.live});}}
  return m;
}
function pushActivity(entry){activityLog.unshift({ts:Date.now()/1000,...entry});if(activityLog.length>ACTIVITY_MAX)activityLog.length=ACTIVITY_MAX;}
function diffAndLog(prev,next){
  if(!prev)return;
  for(const [key,n] of next){
    const p=prev.get(key); if(!p)continue;
    const label=`${n.team_a} vs ${n.team_b}`;
    if(!p.had_live&&n.had_live&&!n.played)pushActivity({icon:"▶",class:"start",text:`Game started — ${label}`});
    if(p.inning&&n.inning&&p.inning!==n.inning)pushActivity({icon:"○",class:"inning",text:`${n.inning} — ${n.team_a} ${n.live_a??0}, ${n.team_b} ${n.live_b??0}`});
    if(p.had_live&&n.had_live&&!n.played&&(p.live_a!==n.live_a||p.live_b!==n.live_b)){const da=(n.live_a??0)-(p.live_a??0),db=(n.live_b??0)-(p.live_b??0),who=da>0?n.team_a:(db>0?n.team_b:null);if(who)pushActivity({icon:"⚾",class:"score",text:`${who} scored — ${n.team_a} ${n.live_a??0}, ${n.team_b} ${n.live_b??0}`});}
    if(!p.played&&n.played){if(n.is_tie)pushActivity({icon:"■",class:"final",text:`Final: ${n.team_a} ${n.a_score} – ${n.team_b} ${n.b_score} (tie)`});else pushActivity({icon:"■",class:"final",text:`Final: ${n.team_a} ${n.a_score} – ${n.team_b} ${n.b_score}`});}
  }
}
function renderActivityFeed(){
  const host=document.getElementById("activity-feed"); if(!host)return;
  const count=activityLog.length;
  if(count===0){host.innerHTML=`<details><summary>Activity <span class="muted">(0)</span></summary><p class="muted activity-empty">Events will appear here as games start, score, and finish.</p></details>`;return;}
  const items=activityLog.map(e=>`<li class="activity-item ${e.class}"><span class="act-time">${fmtTime(e.ts)}</span><span class="act-icon">${e.icon}</span><span class="act-text">${e.text}</span></li>`).join("");
  const wasOpen=host.querySelector("details")?.hasAttribute("open");
  host.innerHTML=`<details${wasOpen?" open":""}><summary>Activity <span class="muted">(${count})</span></summary><ul class="activity-list">${items}</ul></details>`;
}
async function render(data){
  const app=document.getElementById("app");
  const evName=(data.event_name||"").trim();
  document.getElementById("event-name").textContent=evName||"Pool Play Seed Projections";
  document.getElementById("division").textContent=data.division_name||"(loading)";
  const meta=[];
  if(data.event_dates)meta.push(data.event_dates);
  if(data.event_location)meta.push(data.event_location);
  document.getElementById("event-meta").textContent=meta.join(" · ");
  document.title=evName?`${evName} — Pool Seeds`:"Pool Play Seed Projections";
  document.getElementById("fetched").textContent=fmtTime(data.fetched_at);
  const src=document.getElementById("source"); src.href=data.source_url;
  pollState={next_poll_at:data.next_poll_at,next_interval_reason:data.next_interval_reason,next_interval:data.next_interval};
  renderPollState();
  if(data.fetch_error){app.innerHTML=`<div class="error">Fetch error: ${data.fetch_error}</div>`;return;}
  if(!data.pools||data.pools.length===0){app.innerHTML=`<p class="muted">No pool data yet.</p>`;return;}
  snapshotOpenDetails();
  const liveGames=[];
  (data.pools||[]).forEach(pool=>{(pool.games||[]).forEach(g=>{if(g.live)liveGames.push({pool:pool.letter,game:g});});});
  let liveHtml="";
  if(liveGames.length){
    const cards=liveGames.map(({pool,game})=>{const card=renderGame(game);return card.replace('<div class="sb-head">',`<div class="sb-head"><span class="chip">Pool ${pool}</span>`);}).join("");
    liveHtml=`<section class="live-strip"><h2 class="live-strip-title"><span class="live-dot"></span>Live Now<span class="chip">${liveGames.length} game${liveGames.length===1?"":"s"}</span></h2><div class="game-grid">${cards}</div></section>`;
  }
  app.innerHTML=liveHtml+data.pools.map(renderPool).join("");
  const nextGameState=snapshotGames(data);
  diffAndLog(prevGameState,nextGameState);
  prevGameState=nextGameState;
  renderActivityFeed();
  lastRenderedRevision=data.revision;
  lastRenderedData=data;
}
async function fetchAndRender(){
  try{const qs=window.location.search||"";const resp=await fetch("/api/state"+qs);const data=await resp.json();await render(data);}
  catch(err){document.getElementById("app").innerHTML=`<div class="error">Client error: ${err}</div>`;}
}
let _es=null,_lastEventAt=0;
function connectStream(){
  if(_es){try{_es.close();}catch(_){}}
  const es=new EventSource("/api/events");
  _es=es; _lastEventAt=Date.now();
  es.addEventListener("state",(ev)=>{
    _lastEventAt=Date.now();
    try{
      const msg=JSON.parse(ev.data);
      document.getElementById("fetched").textContent=fmtTime(msg.fetched_at);
      if(msg.next_poll_at!=null){pollState={next_poll_at:msg.next_poll_at,next_interval:msg.next_interval,next_interval_reason:msg.next_interval_reason};renderPollState();}
      if(msg.revision!==currentRevision){currentRevision=msg.revision;if(msg.revision!==lastRenderedRevision)fetchAndRender();}
    }catch(err){console.error("bad SSE event",err);}
  });
  es.onerror=()=>{if(!document.hidden&&Date.now()-_lastEventAt>20000){console.warn("SSE stale — reconnecting");try{es.close();}catch(_){}fetchAndRender();setTimeout(connectStream,500);}};
}
document.addEventListener("visibilitychange",()=>{if(document.hidden)return;fetchAndRender();connectStream();});
setInterval(()=>{if(document.hidden)return;if(Date.now()-_lastEventAt>35000){console.warn("SSE watchdog — no events in 35 s, reconnecting");connectStream();}},10000);
fetchAndRender();
connectStream();
</script>

    return `<span class="bp-line">${bid} · ${timeStr}</span>`;
  });
  const popoverRows = [...byBracket.entries()].map(([bid, games]) => {
    const rows = games.slice().sort((a,b)=>(a.scheduled_time||"").localeCompare(b.scheduled_time||"")).map(g => {
      const t = fmtTimeShort(g.scheduled_time)||"?";
      const field = g.field ? `<span class="bp-pop-field">${escapeAttr(g.field)}</span>` : "";
      const seeds = (g.seed_a!=null&&g.seed_b!=null) ? `<span class="bp-pop-seeds">${g.seed_a} v ${g.seed_b}</span>` : "";

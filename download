const LOCK_SVG = '<svg class="seed-lock" viewBox="0 0 16 16" aria-label="seed locked" role="img"><path fill="none" stroke="currentColor" stroke-width="1.6" d="M5 7.5 V5 a3 3 0 0 1 6 0 V7.5"/><rect x="3.25" y="7.5" width="9.5" height="6.5" rx="1.2" fill="currentColor"/></svg>';

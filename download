function abbreviateTeam(name) {
  if (!name) return "";
  const words = name.split(/\s+/).filter(Boolean);
  const firstAlnum = (words[0]||"").replace(/[^a-zA-Z0-9]/g,"");
  if (firstAlnum.length >= 3) return firstAlnum.slice(0,3).toUpperCase();
